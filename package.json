{
  "name": "neira-browser",
  "version": "1.0.27",
  "description": "A custom desktop browser",
  "author": "Neira",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "@aptabase/electron": "^0.3.1",
    "electron-updater": "^6.1.7",
    "better-sqlite3": "^13.0.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^24.9.0"
  },
    "build": {
    "appId": "com.neira.browser",
    "productName": "Neira",
    "directories": {
      "output": "dist"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "NeiraSetup.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "Neira-Installer.dmg",
      "extendInfo": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Web site URL",
            "CFBundleURLSchemes": [
              "http",
              "https"
            ]
          }
        ]
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "mimeTypes": [
        "x-scheme-handler/http",
        "x-scheme-handler/https",
        "text/html",
        "application/pdf"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "neirathe-a11y",
        "repo": "neira-browser"
      }
    ]
  },
  "allowScripts": [
    "electron",
    "better-sqlite3"
  ]
}