{
  "name": "neira-browser",
  "version": "1.0.18",
  "description": "A custom desktop browser",
  "author": "Neira",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "@aptabase/electron": "^0.3.1",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.neira.browser",
    "productName": "Neira",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "NeiraSetup.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "Neira-Installer.dmg"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "neirathe-a11y",
        "repo": "neira-browser"
      }
    ]
  },
  "allowScripts": [
    "electron"
  ]
}